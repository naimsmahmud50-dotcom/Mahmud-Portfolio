# ==============================================================================
# Mahmud Hasan Portfolio — Environment Configuration Template
# All secret tokens remain strictly server-side (never prefix secrets with NEXT_PUBLIC_)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Resend Email Dispatch (Production Contact Form)
# ------------------------------------------------------------------------------
# Get your API key from: https://resend.com
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Destination email where new client inquiries are delivered
CONTACT_EMAIL_TO=mahmudhasan.infodev@gmail.com

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Distributed Edge Rate Limiting)
# ------------------------------------------------------------------------------
# Optional: If unset, the contact route automatically uses an in-memory sliding window.
# Get credentials from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 3. Telegram Bot Notifications (Instant Mobile Lead Alerts)
# ------------------------------------------------------------------------------
# Optional: Receive instant Telegram push alerts when a user submits an inquiry.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 4. Google Gemini API (Portfolio AI Assistant)
# ------------------------------------------------------------------------------
# Optional: Powers the interactive "Ask about Mahmud" AI widget
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 5. Public Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://mahmudhasan.dev
